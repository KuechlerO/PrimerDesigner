# Keep host SQLite / runtime data out of image builds (avoids migrate
# against a production DB during `docker compose build`).
django_data/
*.sqlite3
*.sqlite3-journal

.git/
.gitignore
.cursor/
.pytest_cache/
.pre-commit-config.yaml
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

staticfiles/
staticfiles.tar.gz
reference_data/
*.tar.gz
.DS_Store
codebase_visualization.html
README.md
pytest.ini
requirements-dev.txt
